, ["announcements3", new TokenOverride({Name: "announcements3", Value: "", IsFile: false, IsHTML: true})], ["rules", new TokenOverride({Name: "rules", Value: "<ul>\n  <li>Do not place anything on the poker table except your cards, your chips, and your drink.</li>\n  <li>Keep your cards and chips on the poker table and in plain view. Keep your big chips out front.</li>\n  <li>Never touch another player's cards or chips.</li>\n  <li>Do not bend or mark the cards.</li>\n  <li>Only the english language may be spoken at the table.</li>\n  <li>No speaking on the phone at a table.</li>\n  <li>Please verbally announce your betting action.</li>\n  <li>String bets are not allowed.</li>\n  <li>Do not splash the pot.</li>\n  <li>Only one player to a hand.</li>\n  <li>Players who are all-in must reveal their hands.</li>\n  <li>The cards speak for themselves.</li>\n  <li>Do not reveal your folded cards, either physically or verbally.</li>\n  <li>Immediately inform the Tournament Director when a player is eliminated.</li>\n  <li>No rabbit hunting.</li>\n  <li>Do not act out of turn.</li>\n  <li>Do not 'slow-roll'. Turn over your winning hand promptly.</li>\n  <li>Never reveal another player's mucked cards.</li>\n</ul>", IsFile: false, IsHTML: true})], ["rules2", new TokenOverride({Name: "rules2", Value: "", IsFile: false, IsHTML: true})], ["rules3", new TokenOverride({Name: "rules3", Value: "", IsFile: false, IsHTML: true})], ["farewell", new TokenOverride({Name: "farewell", Value: "Thanks for playing!", IsFile: false, IsHTML: true})], ["farewell2", new TokenOverride({Name: "farewell2", Value: "", IsFile: false, IsHTML: true})], ["farewell3", new TokenOverride({Name: "farewell3", Value: "", IsFile: false, IsHTML: true})]])})})}), L: { V: "3.7.2", L: new LO.Layout({ScreenBox: new LO.ScreenBox({Contents: Map.from([["Main Screen", new LO.Screen({Name: "Main Screen", TopElement: new LO.Column({Elements: [new LO.CellRef({CellName: "Event Name"}), new LO.CellRef({CellName: "Description"